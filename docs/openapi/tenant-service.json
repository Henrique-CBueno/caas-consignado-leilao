{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "tenant-service",
    "description" : "Consulta de tenants (dados de seed; multi-tenancy com RLS). Acesso externo via api-gateway.",
    "version" : "1.0"
  },
  "paths" : {
    "/tenants/{id}" : {
      "get" : {
        "tags" : [ "tenant-controller" ],
        "summary" : "Consulta um tenant pelo id",
        "operationId" : "getTenant",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Tenant encontrado",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TenantResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Tenant inexistente"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "TenantResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
